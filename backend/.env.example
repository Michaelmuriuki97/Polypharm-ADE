# Configure these as private environment variables on Render for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER when empty.
SMTP_FROM=

# Signup emails use these defaults when the values are omitted.
FOUNDER_EMAIL=michaelmuriuki707@gmail.com
FRONTEND_SITE_URL=https://polypharm-ade.vercel.app/clinical-app.html

# Secure cookies are required for the live HTTPS deployment.
COOKIE_SECURE=true

# Optional AI label explainer. Add the real key only as a private Render variable.
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
